# Capital Cipher AI - Environment Example
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets.

# Supabase public project URL.
# Example: https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable/anon key.
# This key is public by design, but Row Level Security and backend policies must still be configured correctly.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Default mode for the frozen legacy frontend.
# Live and testnet execution were removed from this repository.
VITE_DEFAULT_TRADING_MODE=paper

# Optional: app display name.
VITE_APP_NAME=Capital Cipher AI

# Optional: log verbosity for frontend diagnostics.
# Allowed suggested values: debug, info, warn, error
VITE_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY VARIABLES
# -----------------------------------------------------------------------------
# Do not expose the variables below with the VITE_ prefix.
# They must live only in Supabase Edge Function secrets or another secure backend.
# They are documented here as operational reminders, not as frontend variables.

# Provider credentials must not be configured for this legacy application.
# Revoke historical Bybit, Lovable/AI, ElevenLabs, and service-role secrets
# after deploying the frozen Edge Functions. Future integrations belong in
# capital-cipher-platform behind its central security, risk, and execution
# services.
