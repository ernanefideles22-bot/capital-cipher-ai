# Capital Cipher AI - Environment Example
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets.

# Supabase public project URL.
# Example: https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable/anon key.
# This key is public by design, but Row Level Security and backend policies must still be configured correctly.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Default trading mode for the frontend.
# Allowed suggested values: demo, testnet, paper, real
# Keep demo as the default during development.
VITE_DEFAULT_TRADING_MODE=demo

# Frontend safety flag for real-money trading.
# Keep false by default. Enabling this in the frontend is not enough for production safety.
VITE_ENABLE_REAL_TRADING=false

# Optional: explicit exchange environment label used by UI/config logic.
# Allowed suggested values: demo, testnet, mainnet
VITE_EXCHANGE_ENVIRONMENT=demo

# Optional: app display name.
VITE_APP_NAME=Capital Cipher AI

# Optional: log verbosity for frontend diagnostics.
# Allowed suggested values: debug, info, warn, error
VITE_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY VARIABLES
# -----------------------------------------------------------------------------
# Do not expose the variables below with the VITE_ prefix.
# They must live only in Supabase Edge Function secrets or another secure backend.
# They are documented here as operational reminders, not as frontend variables.

# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# BYBIT_ENVIRONMENT=testnet
# ENABLE_REAL_TRADING=false
# MAX_RISK_PER_TRADE_PERCENT=1
# MAX_DAILY_DRAWDOWN_PERCENT=3
# MAX_LEVERAGE=3
# MAX_OPEN_POSITIONS=3
# REQUIRE_STOP_LOSS=true
# REQUIRE_TAKE_PROFIT=true
# GLOBAL_KILL_SWITCH=false
